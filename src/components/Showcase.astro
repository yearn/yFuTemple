---
type TShowcaseImage = {
	src: string,
	width: number,
	height: number
};

type Props = {
	title: string,
	mark: TShowcaseImage,
	art: TShowcaseImage & {alt: string},
	href: string,
	cta: string,
	// the first screen's images load right away, the layout preloads them
	priority?: boolean
};

const {title, mark, art, href, cta, priority = false} = Astro.props;
const loading = priority ? undefined : 'lazy';
---

{/* phones and tablets put the mark over the text, with the art below or beside it; wide screens use three columns */}
<div class="grid grid-cols-1 border-2 border-white md:grid-cols-2 xl:grid-cols-3">
	<div class="row-start-1 flex items-center justify-center px-4 pt-6 md:col-start-1 md:border-r-2 md:border-white md:px-0 md:pt-8 xl:border-r-0 xl:p-8">
		<img
			alt=""
			src={mark.src}
			width={mark.width}
			height={mark.height}
			loading={loading}
			decoding="async"
			class="h-24 w-auto max-w-full object-contain md:aspect-square md:h-auto md:w-40 md:p-2 xl:w-full" />
	</div>
	<div class="row-start-2 flex flex-col border-b-2 border-white p-4 pb-8 md:col-start-1 md:border-b-0 md:border-r-2 md:p-8 md:pb-14 xl:col-start-2 xl:row-start-1 xl:border-x-2">
		{/* the texts keep their own spacing and line breaks, so their paragraphs are written on one line each */}
		<div
			class="space-y-4 font-scope text-base text-white md:text-lg"
			style="white-space: break-spaces">
			<h2 class="mb-6 text-2xl font-bold md:text-4xl">{title}</h2>
			<slot />
		</div>
		<div class="mx-auto mt-8 pt-8 md:mt-auto">
			<a
				href={href}
				aria-label={`${cta}: ${title}`}
				class="button-glowing bg-white font-peste text-black">
				{cta}
				<div class="glow absolute -inset-0 rotate-180 rounded-full"></div>
				<div class="glow absolute -inset-0 rotate-180 rounded-full"></div>
			</a>
		</div>
	</div>
	{/* the art leads where the button does; keyboard and screen reader users get the button alone */}
	<a
		href={href}
		tabindex="-1"
		aria-hidden="true"
		class="row-start-3 flex transition-opacity hover:opacity-90 md:col-start-2 md:row-span-2 md:row-start-1 xl:col-start-3 xl:row-span-1">
		<img
			alt={art.alt}
			src={art.src}
			width={art.width}
			height={art.height}
			loading={loading}
			decoding="async"
			class="w-full object-cover" />
	</a>
</div>
