---
// a nod to 2000s hit counters, it doesn't count anything
const VISITORS = '001337';

const PAGES = [
	['HOME', '/'],
	['COMICS', '/comics/'],
	['FAQ', '/faq/']
];

const LINKS = [
	['TWITTER', 'https://x.com/yearnfi'],
	['DISCORD', 'https://discord.com/invite/yearn'],
	['BLOG', 'https://blog.yearn.fi'],
	['TELEGRAM', 'https://t.me/yearnfinance'],
	['THE BLUE PILL', 'https://yfistory.org']
];
---

<footer class="z-20 mt-12 flex flex-col items-center border-t-2 border-white pb-5 md:mt-20 md:pb-12">
	<div class="my-8 md:my-12">
		<div class="flex flex-row items-center justify-center space-x-1">
			{VISITORS.split('').map((digit) => (
				<div class="flex h-12 w-9 items-center justify-center border-2 border-white bg-black font-chicago tabular-nums text-white">
					{digit}
				</div>
			))}
		</div>
	</div>
	<nav aria-label="Site" class="mb-6 flex w-full flex-row items-center justify-center gap-8 font-monument text-lg text-white md:mb-8 md:text-xl">
		{PAGES.map(([label, href]) => <a href={href} class="hover:underline">{label}</a>)}
	</nav>
	<nav aria-label="Elsewhere" class="flex w-full flex-col items-center justify-center space-x-0 space-y-5 font-monument text-lg text-yblue md:flex-row md:space-x-8 md:space-y-0 md:text-xl">
		{LINKS.map(([label, href]) => (
			<p class="text-shadow transition-all duration-150">
				<a href={href} target="_blank" rel="noreferrer">{label}</a>
			</p>
		))}
	</nav>
</footer>
