{
  "framework": "astro",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/shipping",
      "destination": "/faq/",
      "permanent": true
    },
    {
      "source": "/shipping/",
      "destination": "/faq/",
      "permanent": true
    },
    {
      "source": "/comic",
      "destination": "/comics/",
      "permanent": true
    },
    {
      "source": "/comic/",
      "destination": "/comics/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/audio/:track.opus",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/ogg; codecs=opus"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
