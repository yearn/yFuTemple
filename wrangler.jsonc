{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "y-fu",
  "compatibility_date": "2026-11-10",
  "assets": { "directory": "dist", "not_found_handling": "404-page", "html_handling": "force-trailing-slash" },
  "workers_dev": true,
  "routes": [{ "pattern": "temple.yearn.fi/*", "zone_name": "yearn.fi" }],
  "env": { "preview": { "workers_dev": true, "routes": [] } }
}
